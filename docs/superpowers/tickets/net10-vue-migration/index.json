  "tickets": [
    {
      "schema_version": 1,
      "id": "T01",
      "title": "Toolchain, SQL Server, and project skeletons with /health endpoint",
      "risk": "high",
      "risk_reasons": [
        "Installs system-level tooling (.NET 10 preview SDK, SQL Server 2022) on the host",
        "Provisions the database and stores the SA password in user-secrets",
        "Creates the solution and project skeletons that all later tickets depend on"
      ],
      "depends_on": [],
      "owns": [
        "scripts/install-toolchain.sh",
        "src/backend-net10/ShopApi.sln",
        "src/backend-net10/ShopApi/Program.cs",
        "src/backend-net10/ShopApi/ShopApi.csproj",
        "src/backend-net10/ShopApi/appsettings.json",
        "src/backend-net10/ShopApi/appsettings.Development.json",
        "src/backend-net10/ShopApi/sql/schema.sql",
        "src/backend-net10/ShopApi/wwwroot/.gitkeep",
        "src/backend-net10/ShopApi.Tests/ShopApi.Tests.csproj",
        "src/frontend-vue/package.json",
        "src/frontend-vue/vite.config.ts",
        "src/frontend-vue/tsconfig.json",
        "src/frontend-vue/src/main.ts",
        "src/frontend-vue/src/App.vue",
        "tests/smoke-health.sh"
      ],
      "verification_commands": [
        "dotnet build src/backend-net10/ShopApi.sln",
        "ASPNETCORE_URLS=http://localhost:5000 dotnet run --project src/backend-net10/ShopApi & sleep 3 && curl -sf http://localhost:5000/health && kill %1",
        "bash tests/smoke-health.sh",
        "cd src/frontend-vue && npm install && npm run build"
      ],
      "spec_hash": "a5646e10dfb81f9202e2e333efb64b3651932df00bc4f9d70725d4a189c1433e",
      "approval_hash": "a5646e10dfb81f9202e2e333efb64b3651932df00bc4f9d70725d4a189c1433e"
    },
    {
      "schema_version": 1,
      "id": "T02",
      "title": "Login (JWT auth) — API + Vue login page + route guard",
      "risk": "high",
      "risk_reasons": [
        "Authentication boundary: issues and validates JWTs",
        "Handles credentials and password verification (BCrypt)",
        "Sets the httpOnly auth cookie consumed by every later ticket"

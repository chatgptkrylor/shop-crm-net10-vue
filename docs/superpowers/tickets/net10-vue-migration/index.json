      "depends_on": ["T01"],
      "owns": [
        "src/backend-net10/ShopApi/Controllers/AccountController.cs",
        "src/backend-net10/ShopApi/Infrastructure/JwtTokenService.cs",
        "src/backend-net10/ShopApi/Infrastructure/AuthExtensions.cs",
        "src/backend-net10/ShopApi/Infrastructure/XRequestedWithFilter.cs",
        "src/backend-net10/ShopApi/Infrastructure/DbConnectionFactory.cs",
        "src/backend-net10/ShopApi/Repository/IRepositories.cs",
        "src/backend-net10/ShopApi/Repository/UserRepository.cs",
        "src/backend-net10/ShopApi/Models/LoginRequest.cs",
        "src/backend-net10/ShopApi/Models/UserDto.cs",
        "src/backend-net10/ShopApi.Tests/LoginTests.cs",
        "src/backend-net10/ShopApi.Tests/AuthTests.cs",
        "src/frontend-vue/src/views/LoginView.vue",
        "src/frontend-vue/src/stores/auth.ts",
        "src/frontend-vue/src/api/client.ts",
        "src/frontend-vue/src/api/auth.ts",
        "src/frontend-vue/src/router/index.ts",
        "tests/smoke-auth.sh",
        "tests/browser/login.spec.ts"
      ],
      "verification_commands": [
        "dotnet test src/backend-net10/ShopApi.Tests",
        "bash tests/smoke-auth.sh",
        "cd src/frontend-vue && npm run type-check && npm run build",
        "npx playwright test tests/browser/login.spec.ts"
      ],
      "spec_hash": "a5646e10dfb81f9202e2e333efb64b3651932df00bc4f9d70725d4a189c1433e",
      "approval_hash": "a5646e10dfb81f9202e2e333efb64b3651932df00bc4f9d70725d4a189c1433e"
